# Supabase Configuration
# Obtenha esses valores no painel do Supabase: Settings > API
# Nunca commite valores reais no repositório.

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-do-supabase

# A limpeza das fotos após 30 dias é automática e roda no servidor
# (Supabase Cron -> Edge Function protegida). Nenhuma variável pública
# habilita exclusão no navegador; o segredo vive apenas no servidor.
